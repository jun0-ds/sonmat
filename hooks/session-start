#!/bin/bash
# sonmat session-start hook
# Side effects only — no additionalContext injection.
# All discipline rules live in CLAUDE.md → core.md (prompt-first).

PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# sonmat state lives OUTSIDE any .claude/ dir — Claude Code edit-protects every
# .claude/ (prompting on each Edit/Write, unsuppressable except bypassPermissions).
# An integrating framework (e.g. munteok) can redirect state via the override vars.
SONMAT_HOME="${SONMAT_HOME:-$HOME/.sonmat}"
SONMAT_PROJECTS_BASE="${SONMAT_PROJECTS_BASE:-$SONMAT_HOME/projects}"
SONMAT_MEMORY_DIR="${SONMAT_MEMORY_DIR:-$SONMAT_HOME/memory}"
GLOBAL_CLAUDE_MD="$HOME/.claude/CLAUDE.md"
MSGS=()

# Project slug from cwd, mirroring Claude Code's ~/.claude/projects/{slug}
# (full path → dashes, NOT basename — avoids collisions across same-named/nested projects).
SLUG=$(printf '%s' "$PWD" | sed 's#/#-#g')
PROJ_DIR="$SONMAT_PROJECTS_BASE/$SLUG"

# --- Auto-create project CLAUDE.md (git repos only) ---
if [ -d ".git" ] && [ ! -f "CLAUDE.md" ]; then
  cat > CLAUDE.md << 'TEMPLATE'
# CLAUDE.md

> 글로벌 지침(`~/.claude/CLAUDE.md`) 상속: 사고규율(Before/After Acting), 행동규율(Break/Cross/Ground), 환경식별, 호칭, Python/uv 규칙 등.

## Project Rules

<!-- 대화 중 발견된 프로젝트 규칙이 여기에 추가됩니다. -->
TEMPLATE
  MSGS+=("CLAUDE.md auto-created — review and customize.")
fi

# --- sonmat state dirs (outside .claude) + one-time migration from legacy .claude paths ---
mkdir -p "$SONMAT_HOME" "$SONMAT_MEMORY_DIR"
# memory: legacy ~/.claude/sonmat/memory → SONMAT_MEMORY_DIR (real dir only; skip a symlink an integrator manages)
OLD_MEM="$HOME/.claude/sonmat/memory"
if [ -d "$OLD_MEM" ] && [ ! -L "$OLD_MEM" ] && [ -z "$(ls -A "$SONMAT_MEMORY_DIR" 2>/dev/null)" ] && [ -n "$(ls -A "$OLD_MEM" 2>/dev/null)" ]; then
  mv "$OLD_MEM"/* "$SONMAT_MEMORY_DIR"/ 2>/dev/null && rmdir "$OLD_MEM" 2>/dev/null && MSGS+=("sonmat memory migrated → $SONMAT_MEMORY_DIR")
fi
# project scribe (git repos only): legacy .claude/sonmat → PROJ_DIR
if [ -d ".git" ]; then
  mkdir -p "$PROJ_DIR"
  if [ -d ".claude/sonmat" ] && [ -z "$(ls -A "$PROJ_DIR" 2>/dev/null)" ] && [ -n "$(ls -A ".claude/sonmat" 2>/dev/null)" ]; then
    mv .claude/sonmat/* "$PROJ_DIR"/ 2>/dev/null && rmdir .claude/sonmat 2>/dev/null && MSGS+=("sonmat scribe migrated: .claude/sonmat → $PROJ_DIR")
  fi
fi

# --- Plant sonmat block in global CLAUDE.md (one-time) ---
if [ -f "$GLOBAL_CLAUDE_MD" ] && ! grep -q '## sonmat' "$GLOBAL_CLAUDE_MD"; then
  cat >> "$GLOBAL_CLAUDE_MD" << SONMAT

## sonmat

- Discipline: \`~/.claude/plugins/marketplaces/sonmat/discipline/core.md\`
- Domain hints: \`~/.claude/plugins/marketplaces/sonmat/discipline/hints.md\`
- Memory: \`~/.sonmat/memory/\`
- Scribe logs (per project): \`~/.sonmat/projects/{slug}/\`
SONMAT
  MSGS+=("sonmat reference block (paths) added to ~/.claude/CLAUDE.md.")
fi

# --- Plant sonmat discipline working-command (idempotent; skip if one already exists) ---
# The paths block above is reference-only: it never tells Claude to READ and APPLY the
# discipline. A fresh user therefore gets the file locations but no standing instruction,
# so the discipline engages only weakly. Plant the working command unless the user already
# has one — their own discipline section (detected by a core.md + apply-premise sentinel)
# or this marker. Maintainer machines that keep a hand-written discipline section are skipped,
# so it never duplicates one.
if [ -f "$GLOBAL_CLAUDE_MD" ] \
   && ! grep -q 'sonmat:discipline' "$GLOBAL_CLAUDE_MD" \
   && ! { grep -q 'core\.md' "$GLOBAL_CLAUDE_MD" && grep -qiE '전제|premise' "$GLOBAL_CLAUDE_MD"; }; then
  cat >> "$GLOBAL_CLAUDE_MD" << 'SONMATDISC'

<!-- sonmat:discipline:start -->
## Thinking Discipline (sonmat)

At the start of every session, Read `~/.claude/plugins/marketplaces/sonmat/discipline/core.md` (and the matching domain `hints.md`) and apply that discipline as the premise of every response: doubt before agreeing, verify at the point of action, weight findings by confidence, and ground them in the source. sonmat is the source of truth for this discipline; this block is the standing instruction that engages it.
<!-- sonmat:discipline:end -->
SONMATDISC
  MSGS+=("sonmat discipline working-command added to ~/.claude/CLAUDE.md.")
fi

# --- Update check (time-based: every 3 hours) — NOTIFY only ---
# Claude Code runs the *cached* copy (~/.claude/plugins/cache/.../{version}/),
# which is not a git repo, so the plugin cannot self-update in place via git pull.
# We detect a version mismatch against main and ask the user to run the proper CC
# update command. The message is appended to MSGS so it is actually delivered via
# additionalContext — the prior UPDATE_MSG variable was computed but never output.
UPDATE_CHECK_FILE="$SONMAT_HOME/.last_update_check"
UPDATE_INTERVAL=10800  # 3 hours in seconds

SHOULD_CHECK=false
if [ ! -f "$UPDATE_CHECK_FILE" ]; then
  SHOULD_CHECK=true
else
  LAST_CHECK=$(cat "$UPDATE_CHECK_FILE" 2>/dev/null)
  NOW=$(date +%s)
  if [ -n "$LAST_CHECK" ] && [ $((NOW - LAST_CHECK)) -ge $UPDATE_INTERVAL ]; then
    SHOULD_CHECK=true
  fi
fi

if [ "$SHOULD_CHECK" = true ]; then
  date +%s > "$UPDATE_CHECK_FILE"

  LOCAL_VER=$(grep '"version"' "$PLUGIN_ROOT/.claude-plugin/plugin.json" 2>/dev/null | head -1 | sed 's/.*"version": *"//;s/".*//')
  REMOTE_VER=$(curl -sf --max-time 3 "https://raw.githubusercontent.com/jun0-ds/sonmat/main/.claude-plugin/plugin.json" | grep '"version"' | head -1 | sed 's/.*"version": *"//;s/".*//')

  if [ -n "$REMOTE_VER" ] && [ -n "$LOCAL_VER" ] && [ "$LOCAL_VER" != "$REMOTE_VER" ]; then
    MSGS+=("sonmat ${LOCAL_VER} → ${REMOTE_VER} is available. At the START of the session, briefly tell the user in Korean: sonmat ${LOCAL_VER} → ${REMOTE_VER} 업데이트가 있어요 — '/plugin update sonmat@sonmat' 후 '/reload-plugins'로 적용하세요. 손맛은 코드가 공개돼 있어 적용 전후로 변경 내용을 함께 점검할 수 있어요. If the user wants to review before updating, the marketplace clone at ~/.claude/plugins/marketplaces/sonmat is a git repo tracking main — show its recent commits/diff and check for security concerns (unexpected network calls, credential or file access, destructive commands). If declined, move on and do not nag.")
  fi
fi

# --- Output (minimal or empty) ---
CONTEXT=""
for msg in "${MSGS[@]}"; do
  [ -n "$CONTEXT" ] && CONTEXT="${CONTEXT} "
  CONTEXT="${CONTEXT}${msg}"
done

# Escape for JSON
CONTEXT=$(echo "$CONTEXT" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g')

cat << EOF
{
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "${CONTEXT}"
  }
}
EOF