#!/bin/bash
# sonmat session-start hook
# Side effects only — no additionalContext injection.
# All discipline rules live in CLAUDE.md → core.md (prompt-first).

PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
USER_SONMAT="$HOME/.claude/sonmat"
GLOBAL_CLAUDE_MD="$HOME/.claude/CLAUDE.md"
MSGS=()

# --- Auto-create project CLAUDE.md (git repos only) ---
if [ -d ".git" ] && [ ! -f "CLAUDE.md" ]; then
  cat > CLAUDE.md << 'TEMPLATE'
# CLAUDE.md

> 글로벌 지침(`~/.claude/CLAUDE.md`) 상속: 사고규율(Before/After Acting), 행동규율(Break/Cross/Ground), 환경식별, 호칭, Python/uv 규칙 등.

## Project Rules

<!-- 대화 중 발견된 프로젝트 규칙이 여기에 추가됩니다. -->
TEMPLATE
  MSGS+=("CLAUDE.md auto-created — review and customize.")
fi

# --- Auto-create directories ---
[ -d ".git" ] && [ ! -d ".claude/sonmat" ] && mkdir -p .claude/sonmat
[ ! -d "$USER_SONMAT" ] && mkdir -p "$USER_SONMAT/memory"

# --- Plant sonmat block in global CLAUDE.md (one-time) ---
if [ -f "$GLOBAL_CLAUDE_MD" ] && ! grep -q '## sonmat' "$GLOBAL_CLAUDE_MD"; then
  cat >> "$GLOBAL_CLAUDE_MD" << SONMAT

## sonmat

- Discipline: \`~/.claude/plugins/marketplaces/sonmat/discipline/core.md\`
- Domain hints: \`~/.claude/plugins/marketplaces/sonmat/discipline/hints.md\`
- Memory: \`~/.claude/sonmat/memory/\`
SONMAT
  MSGS+=("sonmat discipline block added to ~/.claude/CLAUDE.md.")
fi

# --- Auto-update check (time-based: every 3 hours) ---
UPDATE_MSG=""
UPDATE_CHECK_FILE="$USER_SONMAT/.last_update_check"
UPDATE_INTERVAL=10800  # 3 hours in seconds

SHOULD_CHECK=false
if [ ! -f "$UPDATE_CHECK_FILE" ]; then
  SHOULD_CHECK=true
else
  LAST_CHECK=$(cat "$UPDATE_CHECK_FILE" 2>/dev/null)
  NOW=$(date +%s)
  if [ -n "$LAST_CHECK" ] && [ $((NOW - LAST_CHECK)) -ge $UPDATE_INTERVAL ]; then
    SHOULD_CHECK=true
  fi
fi

if [ "$SHOULD_CHECK" = true ]; then
  date +%s > "$UPDATE_CHECK_FILE"

  LOCAL_VER=$(grep '"version"' "$PLUGIN_ROOT/.claude-plugin/plugin.json" 2>/dev/null | head -1 | sed 's/.*"version": *"//;s/".*//')
  REMOTE_VER=$(curl -sf --max-time 3 "https://raw.githubusercontent.com/jun0-ds/sonmat/main/.claude-plugin/plugin.json" | grep '"version"' | head -1 | sed 's/.*"version": *"//;s/".*//')

  if [ -n "$REMOTE_VER" ] && [ -n "$LOCAL_VER" ] && [ "$LOCAL_VER" != "$REMOTE_VER" ]; then
    if git -C "$PLUGIN_ROOT" pull origin main --ff-only >/dev/null 2>&1; then
      UPDATE_MSG="sonmat updated: ${LOCAL_VER} → ${REMOTE_VER}. At the START of the session, briefly notify the user: 'sonmat이 ${LOCAL_VER} → ${REMOTE_VER}로 업데이트되었어요. 변경 내용을 점검해볼까요? 손맛은 코드가 공개되어 있어서 언제든 확인할 수 있어요. 다른 플러그인도 한번 살펴볼까요?' If the user accepts sonmat review, run 'git -C ${PLUGIN_ROOT} diff HEAD~1' and review for security concerns. If they also want other plugins reviewed, scan installed plugins under ~/.claude/plugins/ for suspicious patterns (external API calls, credential access, destructive commands). If declined, move on."
    else
      UPDATE_MSG="sonmat update available: ${LOCAL_VER} → ${REMOTE_VER}, but auto-pull failed. Only mention if the user asks about sonmat version."
    fi
  fi
fi

# --- Output (minimal or empty) ---
CONTEXT=""
for msg in "${MSGS[@]}"; do
  [ -n "$CONTEXT" ] && CONTEXT="${CONTEXT} "
  CONTEXT="${CONTEXT}${msg}"
done

# Escape for JSON
CONTEXT=$(echo "$CONTEXT" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g')

cat << EOF
{
  "hookSpecificOutput": {
    "additionalContext": "${CONTEXT}"
  }
}
EOF